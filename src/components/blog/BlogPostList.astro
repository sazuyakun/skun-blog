---
import type { CollectionEntry } from 'astro:content';
import H2 from '../typography/H2.astro';
import T1 from '../typography/T1.astro';
import T2 from '../typography/T2.astro';

type Props = {
	posts: CollectionEntry<'blog'>[];
	variant?: 'compact' | 'archive';
};

const { posts, variant = 'archive' } = Astro.props;

const formatDate = (date: Date) =>
	date.toLocaleDateString('en', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
---

<ol class:list={['post-list', variant]}>
	{
		posts.map((post) => (
			<li>
				<a class="brush-hover brush-hover--paint" href={`/blog/${post.id}/`}>
					<T2 class="sequence" aria-hidden="true">{String(post.data.order).padStart(3, '0')}</T2>
					<span class="post-copy">
						<H2 as="strong">{post.data.title}</H2>
						<T1 as="span" class="description">{post.data.description}</T1>
					</span>
					<T2 as="time" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</T2>
					<T2 class="arrow" aria-hidden="true">---&gt;</T2>
				</a>
			</li>
		))
	}
</ol>

<style>
	.post-list {
		display: grid;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-list a {
		position: relative;
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr) auto auto;
		align-items: center;
		gap: clamp(1rem, 3vw, 2rem);
		padding: clamp(1.15rem, 2.5vw, 1.65rem);
		border: 1px solid transparent;
		text-decoration: none;
	}

	.post-list a::before {
		position: absolute;
		z-index: 1;
		inset: -1px;
		border: 1px solid var(--color-border);
		content: "";
		clip-path: inset(0);
		pointer-events: none;
		transition: clip-path var(--hover-speed) cubic-bezier(0.22, 1, 0.36, 1);
	}

	.post-list a:hover::before,
	.post-list a:focus-visible::before {
		clip-path: inset(0 100% 0 0);
	}

	.post-list a:focus-visible {
		outline-offset: -2px;
	}

	.sequence,
	time,
	.arrow {
		font-family: var(--font-editor);
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.sequence {
		color: var(--color-accent);
		text-align: center;
	}

	.post-copy {
		display: grid;
		gap: 0.35rem;
	}

	.post-copy strong {
		font-weight: 620;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.description {
		max-width: 34rem;
		color: var(--color-muted);
		font-family: var(--font-editor);
		line-height: 1.4;
	}

	time {
		color: var(--color-subtle);
		white-space: nowrap;
	}

	.arrow {
		color: var(--color-accent);
	}

	.compact a {
		grid-template-columns: 3.5rem minmax(0, 1fr) auto;
	}

	.compact .arrow {
		display: none;
	}

	@media (max-width: 640px) {
		.post-list a,
		.compact a {
			grid-template-columns: 2.5rem minmax(0, 1fr) auto;
			align-items: start;
			gap: 0.75rem;
			padding-right: 0;
		}

		time {
			grid-column: 2;
		}

		.arrow {
			grid-column: 3;
			grid-row: 1;
		}

		.compact time {
			grid-column: 2;
			grid-row: 2;
		}
	}
</style>

<script>
	const randomPaintPath = () => {
		const points = [0, 20, 40, 60, 80, 100];
		const top = points.map((x) => `${x}% ${8 + Math.round(Math.random() * 18)}%`);
		const bottom = [...points]
			.reverse()
			.map((x) => `${x}% ${74 + Math.round(Math.random() * 18)}%`);

		return `polygon(${[...top, ...bottom].join(', ')})`;
	};

	document.querySelectorAll<HTMLElement>('.brush-hover--paint').forEach((row) => {
		const randomize = () => row.style.setProperty('--paint-path', randomPaintPath());
		row.addEventListener('pointerenter', randomize);
		row.addEventListener('focus', randomize);
	});
</script>
