---
import { getCollection } from 'astro:content';
import BlogPostList from '../../components/blog/BlogPostList.astro';
import EmptyState from '../../components/EmptyState.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

---

<Layout title="Blog" description="Blog posts from Skun Blog">
	<section class="archive" aria-labelledby="archive-title">
		<p class="eyebrow" id="archive-title">01 / Transmission</p>
		{
			posts.length > 0 ? (
				<BlogPostList posts={posts} />
			) : (
				<EmptyState message="No posts published yet." href="/rss.xml" label="Subscribe for later" />
			)
		}
	</section>
</Layout>
