---
import House from 'phosphor-astro/House.astro';
import HouseFill from 'phosphor-astro/HouseFill.astro';
import Notebook from 'phosphor-astro/Notebook.astro';
import NotebookFill from 'phosphor-astro/NotebookFill.astro';
import User from 'phosphor-astro/User.astro';
import UserFill from 'phosphor-astro/UserFill.astro';
import { SITE_TITLE } from '../../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="mark">*</span>
			{SITE_TITLE}
		</a>
		<div>
			<HeaderLink href="/" label="Home">
				<House slot="icon" class="icon" aria-hidden="true" />
				<HouseFill slot="active-icon" class="icon active-icon" aria-hidden="true" />
			</HeaderLink>
			<HeaderLink href="/blog" label="Blog">
				<Notebook slot="icon" class="icon" aria-hidden="true" />
				<NotebookFill slot="active-icon" class="icon active-icon" aria-hidden="true" />
			</HeaderLink>
			<HeaderLink href="/about" label="About">
				<User slot="icon" class="icon" aria-hidden="true" />
				<UserFill slot="active-icon" class="icon active-icon" aria-hidden="true" />
			</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
		background: color-mix(in srgb, var(--color-background) 88%, transparent);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(var(--shell-width), calc(100% - 2rem));
		margin: auto;
		padding: 1.15rem 0;
	}

	nav a {
		color: inherit;
		font-size: 0.9rem;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
	}

	.mark {
		color: var(--color-accent);
		font-weight: 800;
	}

	nav div {
		display: flex;
		gap: clamp(0.35rem, 2vw, 0.75rem);
		color: var(--color-muted);
	}

	@media (max-width: 520px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.85rem;
		}
	}
</style>
