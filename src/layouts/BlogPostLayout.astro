---
import H1 from '../components/typography/H1.astro';
import Pane from '../components/Pane.astro';
import T2 from '../components/typography/T2.astro';
import Layout from './Layout.astro';

interface Props {
	title: string;
	description: string;
	order: number;
	pubDate: Date;
	updatedDate?: Date;
	heroImageUrl?: string;
}

const { title, description, order, pubDate, heroImageUrl } = Astro.props;
const sequence = String(order).padStart(3, '0');
const formattedPubDate = pubDate.toLocaleDateString('en', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<Layout title={title} description={description}>
	<article class="post" aria-labelledby="post-title">
		<header class="post-header">
			{
				heroImageUrl && (
					<Pane as="div" class="image-plate" padded={false}>
						<img
							class="post-image"
							src={heroImageUrl}
							alt=""
							width="1600"
							height="850"
							loading="eager"
							decoding="async"
						/>
					</Pane>
				)
			}
			<Pane as="div" class="post-heading">
				<T2 class="post-kicker">Field note / {sequence}</T2>
				<H1 id="post-title">{title}</H1>
				<T2 as="time" class="post-date" datetime={pubDate.toISOString()}>{formattedPubDate}</T2>
			</Pane>
		</header>
		<Pane as="div" class="prose">
			<slot />
		</Pane>
		<Pane as="footer" class="post-footer">
			<T2>End / note {sequence}</T2>
			<div>
				<T2 as="a" class="box-link brush-hover" href="/blog">Back to manifest</T2>
				<T2 as="a" class="box-link brush-hover" href="/rss.xml">RSS feed</T2>
			</div>
		</Pane>
	</article>
</Layout>

<style>
	.post {
		--post-width: 880px;
		display: grid;
		gap: var(--pane-gap);
	}

	.post-header {
		display: grid;
		gap: var(--pane-gap);
	}

	.image-plate {
		position: relative;
		overflow: hidden;
		border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
		background: var(--color-surface);
	}

	.post-image {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 10 / 4;
		object-fit: cover;
		filter: saturate(0.62) contrast(1.12) brightness(0.7);
	}

	.post-heading {
		text-align: center;
	}

	.post-header :global(.type-h1) {
		margin-bottom: 1rem;
	}

	.post-kicker {
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		margin-bottom: 1.25rem;
		color: var(--color-accent);
		font-weight: 700;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.post-kicker::before,
	.post-kicker::after {
		flex: 1;
		height: 1px;
		background: color-mix(in srgb, var(--color-accent) 58%, var(--color-border));
		content: "";
		animation: post-line-in 320ms ease-out both;
	}

	.post-kicker::before {
		transform-origin: right;
	}

	.post-kicker::after {
		transform-origin: left;
	}

	@keyframes post-line-in {
		from {
			transform: scaleX(0);
		}
	}

	.post-date {
		display: block;
		margin-top: 1rem;
		color: var(--color-muted);
		letter-spacing: 0.04em;
	}

	.prose {
		width: min(100%, var(--post-width));
		margin-inline: auto;
		font-family: var(--font-editor);
		line-height: 1.65;
	}

	.prose :global(h1),
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4),
	.prose :global(h5),
	.prose :global(h6) {
		margin: 2.5rem 0 1rem;
		color: var(--color-text);
		font-family: var(--font-editor);
		font-weight: 620;
		letter-spacing: -0.04em;
	}

	.prose :global(h1::before),
	.prose :global(h2::before),
	.prose :global(h3::before),
	.prose :global(h4::before),
	.prose :global(h5::before),
	.prose :global(h6::before) {
		display: block;
		margin-bottom: 0.65rem;
		color: var(--color-accent);
		content: "Section /";
		font-family: var(--font-editor);
		font-weight: 650;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(blockquote),
	.prose :global(pre) {
		margin: 0 0 1rem;
	}

	.prose :global(p) {
		max-width: none;
		color: var(--color-muted);
	}

	.prose :global(ul),
	.prose :global(ol) {
		color: var(--color-muted);
		padding-left: 1.25rem;
	}

	.prose :global(li + li) {
		margin-top: 0.4rem;
	}

	.prose :global(blockquote) {
		margin: 2rem 0;
		border: 1px solid var(--color-accent);
		color: var(--color-text);
		font-style: italic;
		padding: 0.25rem 0 0.25rem 1.5rem;
	}

	.prose :global(a) {
		color: var(--color-text);
		text-decoration-color: var(--color-accent);
	}

	.prose :global(strong) {
		color: var(--color-text);
		font-weight: 650;
	}

	.prose :global(hr) {
		margin: 3rem 0;
		border: 0;
		border-top: 1px solid var(--color-border);
	}

	.prose :global(code) {
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		font-family: var(--font-editor);
		padding: 0.1rem 0.3rem;
	}

	.prose :global(pre) {
		overflow-x: auto;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-family: var(--font-editor);
		line-height: 1.65;
		padding: 1.25rem;
	}

	.prose :global(pre code) {
		border: 0;
		background: transparent;
		padding: 0;
	}

	.prose :global(table) {
		display: block;
		overflow-x: auto;
		width: 100%;
		margin: 2rem 0;
		border-collapse: collapse;
		font-family: var(--font-editor);
	}

	.prose :global(th),
	.prose :global(td) {
		border-bottom: 1px solid var(--color-border);
		padding: 0.75rem 1rem 0.75rem 0;
		text-align: left;
	}

	.prose :global(th) {
		color: var(--color-text);
	}

	.post-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		width: min(100%, var(--post-width));
		margin-inline: auto;
		color: var(--color-subtle);
		font-family: var(--font-editor);
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.post-footer div {
		display: flex;
		gap: 1.5rem;
	}

	.post-footer a {
		color: var(--color-muted);
		text-decoration: none;
	}

	@media (max-width: 480px) {
		.post-footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
