---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	index: string;
	label: string;
	mobileLabel?: string;
};

const { href, index, label, mobileLabel = label, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a
	href={href}
	aria-current={isActive ? 'page' : undefined}
	class:list={[className, { active: isActive }]}
	{...props}
>
	<span class="index" aria-hidden="true">{index}</span>
	<span class="label">
		<span class="desktop-label">{label}</span><span class="mobile-label">{mobileLabel}</span>
	</span>
</a>
<style>
	a {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		padding: 0.25rem 0;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
		white-space: nowrap;
		transition: color 220ms ease;
	}

	.index {
		color: var(--color-subtle);
		font-size: 0.58rem;
	}

	a::before {
		content: "";
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 1px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 260ms ease;
	}

	a:hover::before,
	a:focus-visible::before,
	a.active::before {
		transform: scaleX(1);
		transform-origin: left;
	}

	a.active {
		color: var(--color-text);
	}

	a.active .index {
		color: var(--color-accent);
	}

	.mobile-label {
		display: none;
	}

	@media (max-width: 640px) {
		a {
			gap: 0;
			min-height: 2.75rem;
			padding-inline: 0.3rem;
			font-size: 0.62rem;
		}

		.index,
		.desktop-label {
			display: none;
		}

		.mobile-label {
			display: inline;
		}
	}
</style>
