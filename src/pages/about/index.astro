---
import SocialIcon from '../../components/SocialIcon.astro';
import Pane from '../../components/Pane.astro';
import H2 from '../../components/typography/H2.astro';
import T1 from '../../components/typography/T1.astro';
import T2 from '../../components/typography/T2.astro';
import { SOCIALS } from '../../consts';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About" description="About Skun Blog">
	<Pane as="section" class="profile" aria-labelledby="about-title">
		<header class="profile-heading">
			<T1 as="h1" class="eyebrow" id="about-title">About</T1>
		</header>

		<div class="profile-body">
			<Pane as="aside" class="profile-note" aria-label="Personal note">
				<T2 class="note-index">Personnel note / S-26</T2>
				<div class="portrait-placeholder" role="img" aria-label="Placeholder for a portrait photo">
					<T2>Photo / pending</T2>
				</div>
				<T1 class="punchline">Building things to understand how they work.</T1>
				<T2 class="note-signature">S / 26</T2>
			</Pane>

			<Pane as="div" class="statement">
				<H2>Hi, I'm skun</H2>
				<T1>
					I use this space to inspect software, follow systems to their edges, and keep the useful
					parts of what I learn.
				</T1>
				<T1>
					The full biography is still being written. For now, the work and the notes can speak
					first.
				</T1>
				<div class="actions" aria-label="About links">
					<T2 as="a" class="text-link box-link brush-hover" href="/blog">Browse the writing</T2>
					<T2 as="a" class="plain-link box-link brush-hover" href="/">Return home</T2>
				</div>
			</Pane>
		</div>
	</Pane>

	<Pane as="section" class="socials" aria-labelledby="socials-title">
		<header>
			<H2 id="socials-title">Socials</H2>
		</header>
		<nav class="social-links" aria-label="Social profiles">
			{
				SOCIALS.map((social) => (
					<a
						class="brush-hover"
						href={social.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`${social.name} (opens in a new tab)`}
					>
						<span class="social-title">
							<span class="social-icon"><SocialIcon name={social.icon} /></span>
							<H2 as="strong">{social.name}</H2>
						</span>
						<T2 class="arrow" aria-hidden="true">---&gt;</T2>
					</a>
				))
			}
		</nav>
	</Pane>
</Layout>

<style>
	.profile {
		display: grid;
		gap: var(--pane-gap);
	}

	.profile-heading {
		border-bottom: 1px solid var(--color-border);
	}

	.profile-heading .eyebrow {
		margin: 0;
		max-width: none;
		padding-bottom: 1.5rem;
		line-height: 1.1;
	}

	.profile-body {
		display: grid;
		grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
		gap: var(--pane-gap);
	}

	.profile-note {
		background: var(--color-surface);
	}

	.note-index,
	.note-signature,
	.portrait-placeholder span {
		color: var(--color-accent);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.note-index {
		display: block;
		margin-bottom: 1rem;
	}

	.portrait-placeholder {
		position: relative;
		display: flex;
		align-items: end;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background:
			linear-gradient(135deg, transparent calc(50% - 0.5px), color-mix(in srgb, var(--color-accent) 18%, transparent) 50%, transparent calc(50% + 0.5px)),
			linear-gradient(45deg, transparent calc(50% - 0.5px), color-mix(in srgb, var(--color-accent) 18%, transparent) 50%, transparent calc(50% + 0.5px)),
			var(--color-background);
		padding: 0.75rem;
	}

	.punchline {
		margin: 1.25rem 0 1.5rem;
		color: var(--color-text);
		font-weight: 400;
		line-height: 1.35;
	}

	.note-signature {
		display: block;
		padding-top: 0.9rem;
		border-top: 1px solid var(--color-border);
		text-align: right;
	}

	.statement {
		display: flex;
		justify-content: center;
		flex-direction: column;
	}

	.statement :global(.type-h2) {
		margin: 0 0 1.25rem;
		color: var(--color-text);
		font-weight: 620;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.statement > p {
		max-width: 30rem;
	}

	.statement > p + p {
		margin-top: 1.5rem;
	}

	.socials {
		display: grid;
		gap: var(--pane-gap);
	}

	.socials header {
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.socials h2 {
		max-width: none;
		margin: 0;
		font-weight: 620;
		letter-spacing: -0.05em;
	}

	.social-links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.social-links a {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 0.5rem 1rem;
		min-width: 0;
		min-height: 6rem;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		text-decoration: none;
	}

	.social-title {
		display: flex;
		align-items: center;
		height: 1.3rem;
		gap: 0.6rem;
		color: var(--color-text);
		line-height: 1;
	}

	.social-icon {
		display: grid;
		width: 1.2rem;
		height: 1.2rem;
		place-items: center;
	}

	.social-title strong {
		display: flex;
		align-items: center;
		height: 1.2rem;
		color: var(--color-text);
		line-height: 1;
	}

	.social-links .arrow {
		color: var(--color-accent);
		font-weight: 700;
	}

	@media (max-width: 760px) {
		.profile-body {
			grid-template-columns: 1fr;
		}

		.profile-note {
			width: min(100%, 24rem);
		}

		.social-links {
			grid-template-columns: 1fr;
		}

		.social-links a {
			min-height: auto;
			padding: 1.25rem;
		}
	}

</style>
