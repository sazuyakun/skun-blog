---
import SocialIcon from '../../components/SocialIcon.astro';
import { SOCIALS } from '../../consts';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About" description="About Skun Blog">
	<section class="profile" aria-labelledby="about-title">
		<header class="profile-heading">
			<h1 class="eyebrow" id="about-title">About</h1>
		</header>

		<div class="profile-body">
			<aside class="profile-note" aria-label="Personal note">
				<span class="tape" aria-hidden="true"></span>
				<span class="note-index">Personnel note / S-26</span>
				<div class="portrait-placeholder" role="img" aria-label="Placeholder for a portrait photo">
					<span>Photo / pending</span>
				</div>
				<p class="punchline">Building things to understand how they work.</p>
				<span class="note-signature">S / 26</span>
			</aside>

			<div class="statement">
				<h2>Hi, I'm skun</h2>
				<p>
					I use this space to inspect software, follow systems to their edges, and keep the useful
					parts of what I learn.
				</p>
				<p>
					The full biography is still being written. For now, the work and the notes can speak
					first.
				</p>
				<div class="actions" aria-label="About links">
					<a class="text-link" href="/blog">Browse the writing</a>
					<a class="plain-link" href="/">Return home</a>
				</div>
			</div>
		</div>
	</section>

	<section class="socials" aria-labelledby="socials-title">
		<header>
			<h2 id="socials-title">Socials</h2>
		</header>
		<nav class="social-links" aria-label="Social profiles">
			{
				SOCIALS.map((social) => (
					<a
						href={social.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`${social.name} (opens in a new tab)`}
					>
						<span class="social-title">
							<span class="social-icon"><SocialIcon name={social.icon} /></span>
							<strong>{social.name}</strong>
						</span>
						<span class="arrow" aria-hidden="true">---&gt;</span>
					</a>
				))
			}
		</nav>
	</section>
</Layout>

<style>
	.profile {
		margin-bottom: clamp(5rem, 11vw, 9rem);
	}

	.profile-heading {
		border-bottom: 1px solid var(--color-border);
	}

	.profile-heading .eyebrow {
		margin: 0;
		max-width: none;
		padding-bottom: 1.5rem;
		line-height: 1.1;
	}

	.profile-body {
		display: grid;
		grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(3rem, 9vw, 8rem);
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}

	.profile-note {
		position: relative;
		transform: rotate(-1.25deg);
		background:
			linear-gradient(color-mix(in srgb, var(--color-accent) 7%, transparent), color-mix(in srgb, var(--color-accent) 2%, transparent)),
			var(--color-surface);
		box-shadow: 0 1.5rem 3rem color-mix(in srgb, #000 32%, transparent);
		padding: clamp(1.25rem, 3vw, 1.75rem);
		animation: note-settle 420ms ease-out both;
	}

	.tape {
		position: absolute;
		top: -0.8rem;
		left: 50%;
		width: 5.5rem;
		height: 1.45rem;
		transform: translateX(-50%) rotate(2deg);
		background: color-mix(in srgb, var(--color-accent) 32%, #d8d0a5);
		opacity: 0.72;
	}

	.note-index,
	.note-signature,
	.portrait-placeholder span {
		color: var(--color-accent);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.note-index {
		display: block;
		margin-bottom: 1rem;
	}

	.portrait-placeholder {
		position: relative;
		display: flex;
		align-items: end;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background:
			linear-gradient(135deg, transparent calc(50% - 0.5px), color-mix(in srgb, var(--color-accent) 18%, transparent) 50%, transparent calc(50% + 0.5px)),
			linear-gradient(45deg, transparent calc(50% - 0.5px), color-mix(in srgb, var(--color-accent) 18%, transparent) 50%, transparent calc(50% + 0.5px)),
			var(--color-background);
		padding: 0.75rem;
	}

	.punchline {
		margin: 1.25rem 0 1.5rem;
		color: var(--color-text);
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		font-weight: 400;
		line-height: 1.35;
	}

	.note-signature {
		display: block;
		padding-top: 0.9rem;
		border-top: 1px solid var(--color-border);
		text-align: right;
	}

	@keyframes note-settle {
		from {
			opacity: 0;
			transform: translateY(1rem) rotate(-2.5deg);
		}
	}

	.statement {
		align-self: center;
	}

	.statement h2 {
		margin: 0 0 1.25rem;
		color: var(--color-text);
		font-size: clamp(1.2rem, 3vw, 1.65rem);
		font-weight: 620;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}

	.statement > p {
		max-width: 30rem;
	}

	.statement > p + p {
		margin-top: 1.5rem;
	}

	.socials {
		padding-top: clamp(2rem, 5vw, 3.5rem);
		border-top: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
	}

	.socials header {
		margin-bottom: 2.5rem;
	}

	.socials h2 {
		max-width: none;
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 620;
		letter-spacing: -0.05em;
	}

	.social-links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.social-links a {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 0.5rem 1rem;
		min-width: 0;
		min-height: 6rem;
		padding: 1.25rem;
		border-right: 1px solid var(--color-border);
		text-decoration: none;
		transition: background-color 160ms ease;
	}

	.social-links a:first-child {
		padding-left: 0;
	}

	.social-links a:last-child {
		border-right: 0;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		background: color-mix(in srgb, var(--color-accent) 6%, transparent);
	}

	.social-title {
		display: flex;
		align-items: center;
		height: 1.3rem;
		gap: 0.6rem;
		color: var(--color-text);
		font-size: 1.2rem;
		line-height: 1;
	}

	.social-icon {
		display: grid;
		width: 1.2rem;
		height: 1.2rem;
		place-items: center;
	}

	.social-title strong {
		display: flex;
		align-items: center;
		height: 1.2rem;
		color: var(--color-text);
		line-height: 1;
	}

	.social-links .arrow {
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		transition: transform 160ms ease;
	}

	.social-links a:hover .arrow,
	.social-links a:focus-visible .arrow {
		transform: translateX(0.2rem);
	}

	@media (max-width: 760px) {
		.profile-body {
			grid-template-columns: 1fr;
		}

		.profile-note {
			width: min(100%, 24rem);
			transform: rotate(-0.5deg);
		}

		.social-links {
			grid-template-columns: 1fr;
		}

		.social-links a,
		.social-links a:first-child {
			min-height: auto;
			padding: 1.25rem;
			border-right: 0;
			border-bottom: 1px solid var(--color-border);
		}

		.social-links a:last-child {
			border-bottom: 0;
		}
	}

</style>
