---
import Layout from './Layout.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImageUrl?: string;
}

const { title, description, pubDate, updatedDate, heroImageUrl } = Astro.props;
const formattedPubDate = pubDate.toLocaleDateString('en', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const formattedUpdatedDate = updatedDate?.toLocaleDateString('en', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<Layout title={title} description={description}>
	<article class="post" aria-labelledby="post-title">
		<header class="post-header">
			<div class:list={['post-card', { 'has-image': heroImageUrl }]}>
				{
					heroImageUrl && (
						<img class="post-image" src={heroImageUrl} alt="" loading="eager" decoding="async" />
					)
				}
				<div class="post-heading">
					<p class="post-kicker">/blog/post</p>
					<h1 id="post-title">{title}</h1>
					<p class="post-description">{description}</p>
					<div class="post-meta" aria-label="Post metadata">
						<time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
						{
							updatedDate && (
								<span>
									Updated <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>
								</span>
							)
						}
					</div>
				</div>
			</div>
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</Layout>

<style>
	.post {
		--post-width: 680px;
	}

	.post-header {
		padding: clamp(0.25rem, 2vw, 1rem) 0 clamp(3rem, 8vw, 4.5rem);
		text-align: center;
	}

	.post-card {
		position: relative;
		max-width: min(100%, 820px);
		margin: 0 auto;
		border: 1px solid color-mix(in srgb, var(--color-accent) 32%, var(--color-border));
		border-radius: 1.25rem;
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 7%, transparent), transparent 58%),
			var(--color-background);
		padding: clamp(2rem, 7vw, 4.75rem) clamp(1.25rem, 6vw, 4rem);
	}

	.post-card.has-image {
		overflow: hidden;
		padding: 0;
	}

	.post-card::before,
	.post-card::after {
		position: absolute;
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.post-card::before {
		content: "/*";
		top: 1rem;
		left: 1rem;
	}

	.post-card::after {
		content: "*/";
		right: 1rem;
		bottom: 1rem;
	}

	.post-image {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 8.5;
		object-fit: cover;
		border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
		filter: saturate(0.72) contrast(1.08) brightness(0.78);
	}

	.post-heading {
		padding: clamp(2rem, 6vw, 3.5rem) clamp(1.25rem, 6vw, 4rem);
	}

	.post-kicker {
		max-width: none;
		margin-bottom: 1.25rem;
		color: var(--color-accent);
		font-size: 0.85rem;
		font-weight: 650;
		letter-spacing: 0.1em;
		text-transform: lowercase;
	}

	.post-header h1 {
		max-width: 14ch;
		margin: 0 auto 1.25rem;
		font-size: clamp(2.25rem, 8vw, 4.75rem);
	}

	.post-header h1::before {
		display: none;
	}

	.post-description {
		max-width: 34rem;
		margin: 0 auto;
		font-size: clamp(1.05rem, 2.4vw, 1.35rem);
		line-height: 1.5;
	}

	.post-meta {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1rem;
		margin-top: 1.75rem;
		color: var(--color-subtle);
		font-size: 0.95rem;
	}

	.prose {
		max-width: var(--post-width);
		margin: 0 auto;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.prose :global(h2) {
		margin: 2.5rem 0 1rem;
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		font-weight: 620;
		letter-spacing: -0.04em;
	}

	.prose :global(h3) {
		margin: 2rem 0 0.75rem;
		font-size: 1.35rem;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(blockquote),
	.prose :global(pre) {
		margin: 0 0 1.25rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		color: var(--color-muted);
		padding-left: 1.25rem;
	}

	.prose :global(blockquote) {
		border-left: 1px solid var(--color-accent);
		color: var(--color-muted);
		padding-left: 1.25rem;
	}

	.prose :global(code) {
		border: 1px solid var(--color-border);
		border-radius: 0.35rem;
		background: var(--color-surface);
		color: var(--color-text);
		font-size: 0.9em;
		padding: 0.1rem 0.3rem;
	}

	.prose :global(pre) {
		overflow-x: auto;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: var(--color-surface);
		padding: 1rem;
	}

	.prose :global(pre code) {
		border: 0;
		background: transparent;
		padding: 0;
	}

	@media (max-width: 640px) {
		.post-card {
			border-radius: 1rem;
			padding: 2rem 1.1rem;
		}

		.post-image {
			aspect-ratio: 4 / 3;
		}
	}
</style>
