---
import { SITE_TITLE } from '../../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="mark">*</span>
			{SITE_TITLE}
		</a>
		<div>
			<HeaderLink href="/" label="Home">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M4 10.5 12 4l8 6.5V20h-5v-6H9v6H4v-9.5Z" />
				</svg>
			</HeaderLink>
			<HeaderLink href="/blog" label="Blog">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M6 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V5a1 1 0 0 1 1-1Zm2 3v10a1 1 0 0 0 1 1h8V7a1 1 0 0 0-1-1H8Zm2 2h5v2h-5V9Zm0 4h5v2h-5v-2Z" />
				</svg>
			</HeaderLink>
			<HeaderLink href="/about" label="About">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<path d="M12 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm0 10c4.2 0 7 2.2 7 5.5V20H5v-.5C5 16.2 7.8 14 12 14Z" />
				</svg>
			</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
		background: color-mix(in srgb, var(--color-background) 88%, transparent);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(var(--shell-width), calc(100% - 2rem));
		margin: auto;
		padding: 1.15rem 0;
	}

	nav a {
		color: inherit;
		font-size: 0.9rem;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
	}

	.mark {
		color: var(--color-accent);
		font-weight: 800;
	}

	nav div {
		display: flex;
		gap: clamp(0.35rem, 2vw, 0.75rem);
		color: var(--color-muted);
	}

	@media (max-width: 520px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.85rem;
		}
	}
</style>
