---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About" description="About Skun Blog">
	<section class="profile" aria-labelledby="about-title">
		<header class="profile-heading">
			<h1 class="eyebrow" id="about-title">About</h1>
		</header>

		<div class="profile-body">
			<aside class="profile-note" aria-label="Personal note">
				<span class="tape" aria-hidden="true"></span>
				<span class="note-index">Personnel note / S-26</span>
				<div class="portrait-placeholder" role="img" aria-label="Placeholder for a portrait photo">
					<span>Photo / pending</span>
				</div>
				<p class="punchline">Building things to understand how they work.</p>
				<span class="note-signature">S / 26</span>
			</aside>

			<div class="statement">
				<p>
					I use this space to inspect software, follow systems to their edges, and keep the useful
					parts of what I learn.
				</p>
				<p>
					The full biography is still being written. For now, the work and the notes can speak
					first.
				</p>
				<div class="actions" aria-label="About links">
					<a class="text-link" href="/blog">Browse the writing</a>
					<a class="plain-link" href="/">Return home</a>
				</div>
			</div>
		</div>
	</section>

	<section class="colophon" aria-labelledby="colophon-title">
		<header>
			<p class="eyebrow">Site record / 01</p>
			<h2 id="colophon-title">How this place works</h2>
		</header>
		<dl>
			<div><dt>Built with</dt><dd>Astro and plain CSS</dd></div>
			<div><dt>Output</dt><dd>Static by default</dd></div>
			<div><dt>Principle</dt><dd>Write deliberately, decorate usefully</dd></div>
			<div><dt>Feed</dt><dd><a href="/rss.xml">RSS / XML</a></dd></div>
		</dl>
	</section>
</Layout>

<style>
	.profile {
		margin-bottom: clamp(5rem, 11vw, 9rem);
	}

	.profile-heading {
		border-bottom: 1px solid var(--color-border);
	}

	.profile-heading .eyebrow {
		margin: 0;
		max-width: none;
		padding-bottom: 1.5rem;
		line-height: 1.1;
	}

	.profile-body {
		display: grid;
		grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(3rem, 9vw, 8rem);
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}

	.profile-note {
		position: relative;
		transform: rotate(-1.25deg);
		background:
			linear-gradient(color-mix(in srgb, var(--color-accent) 7%, transparent), color-mix(in srgb, var(--color-accent) 2%, transparent)),
			var(--color-surface);
		box-shadow: 0 1.5rem 3rem color-mix(in srgb, #000 32%, transparent);
		padding: clamp(1.25rem, 3vw, 1.75rem);
		animation: note-settle 420ms ease-out both;
	}

	.tape {
		position: absolute;
		top: -0.8rem;
		left: 50%;
		width: 5.5rem;
		height: 1.45rem;
		transform: translateX(-50%) rotate(2deg);
		background: color-mix(in srgb, var(--color-accent) 32%, #d8d0a5);
		opacity: 0.72;
	}

	.note-index,
	.note-signature,
	.portrait-placeholder span {
		color: var(--color-accent);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.note-index {
		display: block;
		margin-bottom: 1rem;
	}

	.portrait-placeholder {
		position: relative;
		display: flex;
		align-items: end;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background:
			linear-gradient(135deg, transparent calc(50% - 0.5px), color-mix(in srgb, var(--color-accent) 18%, transparent) 50%, transparent calc(50% + 0.5px)),
			linear-gradient(45deg, transparent calc(50% - 0.5px), color-mix(in srgb, var(--color-accent) 18%, transparent) 50%, transparent calc(50% + 0.5px)),
			var(--color-background);
		padding: 0.75rem;
	}

	.punchline {
		margin: 1.25rem 0 1.5rem;
		color: var(--color-text);
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		font-weight: 400;
		line-height: 1.35;
	}

	.note-signature {
		display: block;
		padding-top: 0.9rem;
		border-top: 1px solid var(--color-border);
		text-align: right;
	}

	@keyframes note-settle {
		from {
			opacity: 0;
			transform: translateY(1rem) rotate(-2.5deg);
		}
	}

	.statement {
		align-self: center;
	}

	.statement > p {
		max-width: 30rem;
	}

	.statement > p + p {
		margin-top: 1.5rem;
	}

	.colophon {
		padding-top: clamp(2rem, 5vw, 3.5rem);
		border-top: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
	}

	.colophon header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.colophon .eyebrow {
		margin: 0;
	}

	.colophon h2 {
		max-width: none;
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 620;
		letter-spacing: -0.05em;
		text-align: right;
	}

	.colophon dl {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin: 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.colophon dl div {
		min-height: 9rem;
		padding: 1.25rem;
		border-right: 1px solid var(--color-border);
	}

	.colophon dl div:first-child {
		padding-left: 0;
	}

	.colophon dl div:last-child {
		border-right: 0;
	}

	.colophon dt {
		margin-bottom: 2rem;
		color: var(--color-subtle);
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.colophon dd {
		margin: 0;
		color: var(--color-muted);
		font-size: 1.08rem;
		line-height: 1.35;
	}

	@media (max-width: 760px) {
		.profile-body {
			grid-template-columns: 1fr;
		}

		.profile-note {
			width: min(100%, 24rem);
			transform: rotate(-0.5deg);
		}

		.colophon dl {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.colophon dl div {
			border-bottom: 1px solid var(--color-border);
		}

		.colophon dl div:nth-child(2) {
			border-right: 0;
		}

		.colophon dl div:nth-last-child(-n + 2) {
			border-bottom: 0;
		}

		.colophon dl div:first-child {
			padding-left: 1.25rem;
		}
	}

	@media (max-width: 480px) {
		.colophon header {
			align-items: start;
			flex-direction: column;
		}

		.colophon h2 {
			text-align: left;
		}

		.colophon dl {
			grid-template-columns: 1fr;
		}

		.colophon dl div,
		.colophon dl div:nth-child(2),
		.colophon dl div:nth-last-child(-n + 2) {
			min-height: auto;
			border-right: 0;
			border-bottom: 1px solid var(--color-border);
		}

		.colophon dl div:last-child {
			border-bottom: 0;
		}

		.colophon dt {
			margin-bottom: 0.75rem;
		}
	}
</style>
