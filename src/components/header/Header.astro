---
import { SITE_TITLE } from '../../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="site-title" href="/" aria-label={`${SITE_TITLE} home`}>
			<img src="/images/main_logo.png" alt="" width="48" height="48" />
			<span>skun / field log</span>
		</a>
		<div class="nav-links">
			<HeaderLink href="/" index="01" label="Home" />
			<HeaderLink href="/blog" index="02" label="Writing" mobileLabel="Write" />
			<HeaderLink href="/about" index="03" label="About" />
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
		background: color-mix(in srgb, var(--color-background) 92%, transparent);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(var(--shell-width), calc(100% - 2rem));
		margin: auto;
		padding: 1rem 0;
	}

	nav a {
		color: inherit;
		font-size: 0.9rem;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		min-width: 2.75rem;
		min-height: 2.75rem;
		line-height: 0;
	}

	.site-title img {
		display: block;
		width: 2.25rem;
		height: auto;
		filter: brightness(0) invert(1);
	}

	.site-title span {
		color: var(--color-subtle);
		font-family: var(--font-atkinson);
		font-size: 0.65rem;
		font-weight: 650;
		letter-spacing: 0.12em;
		line-height: 1;
		text-transform: uppercase;
	}

	.nav-links {
		display: flex;
		flex: 0 0 auto;
		gap: clamp(0.6rem, 3vw, 2rem);
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.site-title span {
			display: none;
		}

		.nav-links {
			gap: clamp(0.2rem, 2vw, 0.75rem);
		}
	}
</style>
