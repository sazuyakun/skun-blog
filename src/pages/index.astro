---
import EmptyState from '../components/EmptyState.astro';
import SectionBlock from '../components/SectionBlock.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="page-hero" aria-labelledby="home-title">
		<p class="eyebrow">~/skun-blog</p>
		<h1 id="home-title">Notes from the edge of code.</h1>
		<p class="lede">
			A quiet place for writing about software, systems, experiments, and the ideas that keep
			showing up while building things.
		</p>
		<div class="actions" aria-label="Primary links">
			<a class="text-link" href="/blog">Read the blog</a>
			<a class="plain-link" href="/about">About</a>
		</div>
	</section>

	<SectionBlock eyebrow="latest" title="Writing" titleId="latest-title">
		<EmptyState message="No posts published yet." href="/blog" label="Open the archive" />
	</SectionBlock>
</Layout>
