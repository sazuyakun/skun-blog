---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About" description="About Skun Blog">
	<section class="profile" aria-labelledby="about-title">
		<header class="profile-heading">
			<p class="eyebrow">About / operator 03</p>
			<h1 id="about-title">The person behind the notes.</h1>
		</header>

		<div class="profile-body">
			<aside class="identity-card" aria-label="Profile status">
				<span class="card-index">Personnel record / S-26</span>
				<span class="monogram" aria-hidden="true">S</span>
				<div class="status">
					<span>Status</span>
					<strong>Biography in progress</strong>
				</div>
			</aside>

			<div class="statement">
				<p class="lede">
					I use this space to inspect software, follow systems to their edges, and keep the useful
					parts of what I learn.
				</p>
				<p>
					The full biography is still being written. For now, the work and the notes can speak
					first.
				</p>
				<div class="actions" aria-label="About links">
					<a class="text-link" href="/blog">Browse the writing</a>
					<a class="plain-link" href="/">Return home</a>
				</div>
			</div>
		</div>
	</section>

	<section class="colophon" aria-labelledby="colophon-title">
		<header>
			<p class="eyebrow">Site record / 01</p>
			<h2 id="colophon-title">How this place works</h2>
		</header>
		<dl>
			<div><dt>Built with</dt><dd>Astro and plain CSS</dd></div>
			<div><dt>Output</dt><dd>Static by default</dd></div>
			<div><dt>Principle</dt><dd>Write deliberately, decorate usefully</dd></div>
			<div><dt>Feed</dt><dd><a href="/rss.xml">RSS / XML</a></dd></div>
		</dl>
	</section>
</Layout>

<style>
	.profile {
		margin-bottom: clamp(5rem, 11vw, 9rem);
	}

	.profile-heading {
		display: grid;
		grid-template-columns: minmax(11rem, 0.55fr) minmax(0, 1.45fr);
		align-items: start;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.profile-heading .eyebrow {
		margin: 0;
		padding: 1.5rem 1.5rem 1.5rem 0;
	}

	.profile-heading h1 {
		max-width: 10ch;
		margin: 0;
		border-left: 1px solid var(--color-border);
		font-size: clamp(3.25rem, 8vw, 7rem);
		padding: clamp(2rem, 5vw, 4rem);
	}

	.profile-body {
		display: grid;
		grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(3rem, 9vw, 8rem);
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}

	.identity-card {
		position: relative;
		display: flex;
		min-height: 25rem;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--color-accent) 50%, var(--color-border));
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 55%),
			var(--color-surface);
		padding: 1.25rem;
	}

	.identity-card::after {
		position: absolute;
		right: -3.5rem;
		bottom: -3.5rem;
		width: 8rem;
		height: 8rem;
		border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
		content: "";
		transform: rotate(45deg);
	}

	.card-index,
	.status span {
		color: var(--color-accent);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.monogram {
		align-self: center;
		color: var(--color-accent);
		font-size: clamp(9rem, 20vw, 14rem);
		font-weight: 700;
		line-height: 0.75;
		opacity: 0.9;
	}

	.status {
		display: grid;
		gap: 0.35rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}

	.status strong {
		font-size: 1rem;
		font-weight: 400;
	}

	.statement {
		align-self: center;
	}

	.statement .lede {
		max-width: 31rem;
		margin-bottom: 1.5rem;
		color: var(--color-text);
		font-size: clamp(1.6rem, 3.5vw, 2.35rem);
		letter-spacing: -0.025em;
		line-height: 1.25;
	}

	.statement > p:not(.lede) {
		max-width: 30rem;
	}

	.colophon {
		padding-top: clamp(2rem, 5vw, 3.5rem);
		border-top: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
	}

	.colophon header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.colophon .eyebrow {
		margin: 0;
	}

	.colophon h2 {
		max-width: none;
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 620;
		letter-spacing: -0.05em;
		text-align: right;
	}

	.colophon dl {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin: 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.colophon dl div {
		min-height: 9rem;
		padding: 1.25rem;
		border-right: 1px solid var(--color-border);
	}

	.colophon dl div:first-child {
		padding-left: 0;
	}

	.colophon dl div:last-child {
		border-right: 0;
	}

	.colophon dt {
		margin-bottom: 2rem;
		color: var(--color-subtle);
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.colophon dd {
		margin: 0;
		color: var(--color-muted);
		font-size: 1.08rem;
		line-height: 1.35;
	}

	@media (max-width: 760px) {
		.profile-heading,
		.profile-body {
			grid-template-columns: 1fr;
		}

		.profile-heading h1 {
			border-top: 1px solid var(--color-border);
			border-left: 0;
			padding-inline: 0;
		}

		.identity-card {
			min-height: 20rem;
		}

		.colophon dl {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.colophon dl div {
			border-bottom: 1px solid var(--color-border);
		}

		.colophon dl div:nth-child(2) {
			border-right: 0;
		}

		.colophon dl div:nth-last-child(-n + 2) {
			border-bottom: 0;
		}

		.colophon dl div:first-child {
			padding-left: 1.25rem;
		}
	}

	@media (max-width: 480px) {
		.colophon header {
			align-items: start;
			flex-direction: column;
		}

		.colophon h2 {
			text-align: left;
		}

		.colophon dl {
			grid-template-columns: 1fr;
		}

		.colophon dl div,
		.colophon dl div:nth-child(2),
		.colophon dl div:nth-last-child(-n + 2) {
			min-height: auto;
			border-right: 0;
			border-bottom: 1px solid var(--color-border);
		}

		.colophon dl div:last-child {
			border-bottom: 0;
		}

		.colophon dt {
			margin-bottom: 0.75rem;
		}
	}
</style>
