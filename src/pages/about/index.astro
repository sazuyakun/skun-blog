---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About" description="About Skun Blog">
	<section class="page-hero" aria-labelledby="about-title">
		<p class="eyebrow">/about</p>
		<h1 id="about-title">About, eventually.</h1>
		<p class="lede">
			This page will hold the personal details, context, and ways to connect. For now, it stays
			intentionally light while the shape of the site settles.
		</p>
		<div class="actions" aria-label="About links">
			<a class="text-link" href="/">Back home</a>
			<a class="plain-link" href="/blog">Read the blog</a>
		</div>
	</section>

	<section class="section-grid" aria-labelledby="status-title">
		<div class="section-heading">
			<p class="eyebrow">status</p>
			<h2 id="status-title">Placeholder</h2>
		</div>
		<div class="empty-state">
			<p>Personal details are not written yet.</p>
			<a class="text-link" href="/blog">Browse writing instead</a>
		</div>
	</section>
</Layout>
