---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	label: string;
};

const { href, label, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={href} aria-label={label} class:list={[className, { active: isActive }]} {...props}>
	<span class="icon-wrap">
		<slot name="icon" />
		<slot name="active-icon" />
	</span>
	<span class="label">{label}</span>
</a>
<style>
	a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-width: 2.4rem;
		min-height: 2.4rem;
		padding: 0 0.6rem;
		line-height: 1.2;
		white-space: nowrap;
		transition: color 220ms ease;
	}

	.icon-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.2rem;
		height: 1.2rem;
		flex: 0 0 auto;
	}

	.icon-wrap :global(.icon) {
		width: 1.2rem;
		height: 1.2rem;
		display: block;
	}

	.icon-wrap :global(.active-icon),
	a.active .icon-wrap :global(.icon:not(.active-icon)) {
		display: none;
	}

	a.active .icon-wrap :global(.active-icon) {
		display: block;
	}

	.label {
		display: inline-flex;
		align-items: center;
		max-width: 0;
		margin-left: 0;
		overflow: hidden;
		opacity: 0;
		line-height: 1.4;
		transition:
			margin-left 260ms ease,
			max-width 260ms ease,
			opacity 180ms ease 90ms;
	}

	a::before {
		content: "";
		position: absolute;
		right: 0;
		bottom: -0.35rem;
		left: 0;
		height: 1px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 260ms ease;
	}

	a:hover::before,
	a:focus-visible::before,
	a.active::before {
		transform: scaleX(1);
		transform-origin: left;
	}

	a:hover .label,
	a:focus-visible .label {
		max-width: 5rem;
		margin-left: 0.45rem;
		opacity: 1;
	}

	a.active {
		color: var(--color-text);
	}
</style>
