---
import { getCollection } from 'astro:content';
import BlogPostList from '../components/blog/BlogPostList.astro';
import EmptyState from '../components/EmptyState.astro';
import Pane from '../components/Pane.astro';
import SpinningDonut from '../components/SpinningDonut.astro';
import H1 from '../components/typography/H1.astro';
import T1 from '../components/typography/T1.astro';
import T2 from '../components/typography/T2.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestPosts = (await getCollection('blog', ({ data }) => data.draft !== true))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Pane as="section" class="home-hero" aria-labelledby="home-title">
		<div class="hero-copy">
			<T2 as="p" class="eyebrow">Personal dispatch / systems and software</T2>
			<H1 id="home-title">Notes from the edge of code.</H1>
			<T1 class="lede">
				A working log of software, systems, experiments, and the ideas that survive building
				things.
			</T1>
			<div class="actions" aria-label="Primary links">
				<T2 as="a" class="text-link box-link brush-hover" href="/blog">Read the latest</T2>
				<T2 as="a" class="plain-link box-link brush-hover" href="/about">About me</T2>
			</div>
		</div>
		<SpinningDonut />
	</Pane>

	<Pane as="section" class="transmissions" aria-labelledby="latest-title">
		<header>
			<T1 as="h2" class="eyebrow" id="latest-title">Latest posts</T1>
			<T1 as="a" class="plain-link box-link brush-hover" href="/blog">Full manifest</T1>
		</header>
		{
			latestPosts.length > 0 ? (
				<BlogPostList posts={latestPosts} variant="compact" />
			) : (
				<EmptyState message="No posts published yet." href="/blog" label="Open the archive" />
			)
		}
	</Pane>
</Layout>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
		min-height: clamp(22rem, 55vh, 34rem);
	}

	.hero-copy h1 {
		max-width: 14ch;
	}

	.hero-copy .lede {
		max-width: 34rem;
	}

	.transmissions {
		display: grid;
		gap: 1rem;
	}

	.transmissions > header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.transmissions h2.eyebrow {
		margin: 0;
	}

	@media (max-width: 800px) {
		.home-hero {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.home-hero :global(.donut) {
			order: -1;
			width: min(100%, 24rem);
			margin-inline: auto;
		}
	}

	@media (max-width: 480px) {
		.transmissions > header {
			align-items: start;
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
