---
import T2 from '../typography/T2.astro';
import HeaderLink from './HeaderLink.astro';

const isHome = Astro.url.pathname === '/';
---

<header>
	<nav>
		<a class:list={['site-title', 'brush-hover', { active: isHome }]} href="/">
			<img src="/images/assets/main_logo.png" alt="" width="48" height="48" />
			<T2>skun / field log</T2>
		</a>
		<div class="nav-links">
			<HeaderLink href="/blog" label="Blog" />
			<HeaderLink href="/about" label="About" />
		</div>
	</nav>
</header>
<style>
	header {
		border: 1px solid var(--color-border);
		background: var(--color-background);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem;
	}

	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		min-width: 2.75rem;
		min-height: 3rem;
		border: 1px solid var(--color-border);
		color: inherit;
		line-height: 0;
		padding: 0.35rem 0.8rem;
		text-decoration: none;
	}

	.site-title img {
		display: block;
		width: 2.25rem;
		height: auto;
		filter: brightness(0) invert(1);
	}

	.site-title:hover img,
	.site-title:focus-visible img {
		filter: brightness(0);
	}

	.site-title span {
		color: var(--color-muted);
		font-family: var(--font-editor);
		font-weight: 400;
		letter-spacing: 0.08em;
		line-height: 1;
		text-transform: uppercase;
	}

	.site-title.active {
		border-color: var(--color-accent);
	}

	.nav-links {
		display: flex;
		flex: 0 0 auto;
		gap: 0.5rem;
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		nav {
			gap: 0.35rem;
		}

		.site-title {
			gap: 0.45rem;
			padding-inline: 0.55rem;
		}

		.site-title img {
			width: 1.75rem;
		}
	}
</style>
