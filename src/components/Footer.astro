---
import SocialIcon from './SocialIcon.astro';
import { SOCIALS } from '../consts';

const today = new Date();
---

<footer>
	<div>
		<span class="end-mark">End of log</span>
		<nav aria-label="Footer links">
			<a href="/rss.xml">RSS</a>
		</nav>
		<div class="footer-meta">
			<span>&copy; {today.getFullYear()} Skun Blog</span>
			<nav class="social-icons" aria-label="Social profiles">
				{
					SOCIALS.map((social) => (
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${social.name} (opens in a new tab)`}
						>
							<SocialIcon name={social.icon} />
						</a>
					))
				}
			</nav>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
		color: var(--color-muted);
		font-family: var(--font-atkinson);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		padding: 2rem var(--gutter);
		text-transform: uppercase;
	}

	footer > div {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 2rem;
		width: min(var(--shell-width), 100%);
		margin: auto;
	}

	.end-mark {
		display: flex;
		align-items: center;
		height: 1rem;
		color: var(--color-accent);
		line-height: 1;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	a {
		text-decoration: none;
	}

	footer > div > nav a,
	.footer-meta > span {
		display: flex;
		align-items: center;
		height: 1rem;
		line-height: 1;
	}

	.footer-meta,
	.social-icons {
		display: flex;
		align-items: center;
	}

	.footer-meta {
		justify-content: flex-end;
		gap: 1rem;
		text-align: right;
		white-space: nowrap;
	}

	.social-icons {
		gap: 0.65rem;
	}

	.social-icons a {
		display: grid;
		width: 1rem;
		height: 1rem;
		place-items: center;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1;
		transition: color 160ms ease;
	}

	.social-icons a:hover,
	.social-icons a:focus-visible {
		color: var(--color-accent);
	}

	@media (max-width: 640px) {
		footer > div {
			grid-template-columns: 1fr auto;
			gap: 0.75rem;
		}

		nav {
			display: none;
		}
	}
</style>
