---
import { getCollection } from 'astro:content';
import BlogPostList from '../../components/blog/BlogPostList.astro';
import EmptyState from '../../components/EmptyState.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => a.data.order - b.data.order,
);

---

<Layout title="Blog" description="Blog posts from Skun Blog">
	<div class="record-line">
		<span>Archive / Manifest 02</span>
		<span>{String(posts.length).padStart(3, '0')} entries</span>
	</div>

	<section class="archive-hero" aria-labelledby="blog-title">
		<div class="signal-rail">
			<p class="eyebrow">Writing register / manually sequenced</p>
			<h1 id="blog-title">Ordered writing.</h1>
		</div>
		<div class="archive-intro">
			<p class="lede">
				Notes and experiments filed in the order they are meant to be read, not the order an
				algorithm prefers.
			</p>
			<div class="actions" aria-label="Blog links">
				<a class="text-link" href="/rss.xml">Follow the signal</a>
				<a class="plain-link" href="/">Return home</a>
			</div>
		</div>
	</section>

	<section class="archive" aria-labelledby="archive-title">
		<header>
			<div>
				<p class="eyebrow">01 / Transmission log</p>
				<h2 id="archive-title">The manifest</h2>
			</div>
			<div class="columns" aria-hidden="true">
				<span>No.</span><span>Transmission</span><span>Filed</span>
			</div>
		</header>
		{
			posts.length > 0 ? (
				<BlogPostList posts={posts} />
			) : (
				<EmptyState message="No posts published yet." href="/rss.xml" label="Subscribe for later" />
			)
		}
	</section>
</Layout>

<style>
	.archive-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
		align-items: end;
		gap: clamp(3rem, 8vw, 7rem);
		padding-bottom: clamp(5rem, 10vw, 8rem);
	}

	.archive-hero h1 {
		max-width: 8ch;
	}

	.archive-intro {
		padding-bottom: 0.5rem;
	}

	.archive-intro .lede {
		font-family: var(--font-reading);
		font-size: clamp(1.25rem, 2.7vw, 1.55rem);
	}

	.archive {
		padding-top: 2.5rem;
		border-top: 1px solid var(--color-border);
	}

	.archive > header {
		margin-bottom: 2rem;
	}

	.archive .eyebrow {
		margin-bottom: 0.5rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 620;
		letter-spacing: -0.05em;
	}

	.columns {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr) auto;
		gap: clamp(1rem, 3vw, 2rem);
		margin-top: 2.5rem;
		padding: 0 4.5rem 0 0;
		color: var(--color-subtle);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 650;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.columns span:first-child {
		text-align: center;
	}

	.columns span:last-child {
		text-align: right;
	}

	@media (max-width: 760px) {
		.archive-hero {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.archive-intro {
			margin-left: 1.25rem;
		}

		.columns {
			display: none;
		}
	}
</style>
