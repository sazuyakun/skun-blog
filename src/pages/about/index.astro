---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="About" description="About Skun Blog">
	<section class="about-hero" aria-labelledby="about-title">
		<div class="about-copy signal-rail">
			<p class="eyebrow">Operator / observer / builder</p>
			<h1 id="about-title">The person behind the notes.</h1>
			<p class="lede">
				I use this space to inspect software, follow systems to their edges, and keep the useful
				parts of what I learn.
			</p>
			<div class="actions" aria-label="About links">
				<a class="text-link" href="/blog">Browse the writing</a>
				<a class="plain-link" href="/">Return home</a>
			</div>
		</div>

		<aside class="margin-note" aria-labelledby="note-title">
			<span class="tape" aria-hidden="true"></span>
			<p class="eyebrow" id="note-title">Margin note / status</p>
			<p>The full biography is still being written. For now, the work and the notes can speak first.</p>
			<span class="initial">S / 26</span>
		</aside>
	</section>

	<section class="colophon" aria-labelledby="colophon-title">
		<header>
			<p class="eyebrow">01 / Site colophon</p>
			<h2 id="colophon-title">How this place works</h2>
		</header>
		<dl>
			<div><dt>Built with</dt><dd>Astro and plain CSS</dd></div>
			<div><dt>Output</dt><dd>Static by default</dd></div>
			<div><dt>Principle</dt><dd>Write deliberately, decorate usefully</dd></div>
			<div><dt>Feed</dt><dd><a href="/rss.xml">RSS / XML</a></dd></div>
		</dl>
	</section>
</Layout>

<style>
	.about-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.55fr);
		align-items: center;
		gap: clamp(3rem, 9vw, 8rem);
		padding-bottom: clamp(5rem, 10vw, 8rem);
	}

	.about-copy h1 {
		max-width: 9ch;
		font-size: clamp(3.25rem, 8vw, 6.5rem);
	}

	.margin-note {
		position: relative;
		transform: rotate(1.5deg);
		border: 1px solid color-mix(in srgb, var(--color-accent) 58%, var(--color-border));
		background:
			linear-gradient(color-mix(in srgb, var(--color-accent) 6%, transparent), color-mix(in srgb, var(--color-accent) 2%, transparent)),
			var(--color-surface);
		padding: clamp(1.5rem, 4vw, 2.25rem);
	}

	.margin-note .tape {
		position: absolute;
		top: -0.75rem;
		left: 50%;
		width: 4.5rem;
		height: 1.4rem;
		transform: translateX(-50%) rotate(-2deg);
		background: color-mix(in srgb, var(--color-accent) 34%, #d8d0a5);
		opacity: 0.65;
	}

	.margin-note p:not(.eyebrow) {
		color: var(--color-text);
		font-family: var(--font-atkinson);
		font-size: 1.2rem;
		line-height: 1.45;
	}

	.initial {
		display: block;
		margin-top: 2rem;
		color: var(--color-accent);
		font-family: var(--font-atkinson);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-align: right;
	}

	.colophon {
		display: grid;
		grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(2rem, 8vw, 6rem);
		padding-top: 2.5rem;
		border-top: 1px solid var(--color-border);
	}

	.colophon .eyebrow {
		margin-bottom: 0.5rem;
	}

	h2 {
		max-width: 9ch;
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 620;
		letter-spacing: -0.05em;
	}

	dl {
		margin: 0;
		border-top: 1px solid var(--color-border);
	}

	dl div {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	dt {
		color: var(--color-subtle);
		font-family: var(--font-atkinson);
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	dd {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-atkinson);
		font-size: 1.08rem;
	}

	@media (max-width: 760px) {
		.about-hero,
		.colophon {
			grid-template-columns: 1fr;
		}

		.margin-note {
			margin-left: 1.25rem;
			transform: rotate(0.6deg);
		}
	}
</style>
