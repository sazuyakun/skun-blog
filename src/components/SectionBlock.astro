---
type Props = {
	eyebrow: string;
	title: string;
	titleId: string;
};

const { eyebrow, title, titleId } = Astro.props;
---

<section class="section-grid" aria-labelledby={titleId}>
	<div class="section-heading">
		<p class="eyebrow">{eyebrow}</p>
		<h2 id={titleId}>{title}</h2>
	</div>
	<slot />
</section>

<style>
	.section-grid {
		display: grid;
		grid-template-columns: minmax(0, 12rem) 1fr;
		gap: 2rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		font-weight: 620;
		letter-spacing: -0.04em;
	}

	@media (max-width: 640px) {
		.section-grid {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
