---
import T1 from './typography/T1.astro';
import T2 from './typography/T2.astro';

type Props = {
	message: string;
	href: string;
	label: string;
};

const { message, href, label } = Astro.props;
---

<div class="empty-state">
	<T1>{message}</T1>
	<T2 as="a" class="text-link" href={href}>{label}</T2>
</div>

<style>
	.empty-state {
		position: relative;
		padding: 1.25rem 0 1.25rem 1.25rem;
	}

	.empty-state::before {
		content: "";
		position: absolute;
		top: 0.45rem;
		bottom: 0.45rem;
		left: 0;
		width: 1px;
		background: color-mix(in srgb, var(--color-accent) 70%, var(--color-border));
	}

	.empty-state p {
		margin-bottom: 0.75rem;
	}

	@media (max-width: 640px) {
		.empty-state {
			padding-top: 0.5rem;
		}
	}
</style>
