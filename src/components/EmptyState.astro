---
import T1 from './typography/T1.astro';
import T2 from './typography/T2.astro';
import Pane from './Pane.astro';

type Props = {
	message: string;
	href: string;
	label: string;
};

const { message, href, label } = Astro.props;
---

<Pane as="div" class="empty-state">
	<T1>{message}</T1>
	<T2 as="a" class="text-link box-link brush-hover" href={href}>{label}</T2>
</Pane>

<style>
	.empty-state {
		display: grid;
		gap: 1rem;
	}

	.empty-state p {
		margin-bottom: 0.75rem;
	}

</style>
