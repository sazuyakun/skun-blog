---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => a.data.order - b.data.order,
);

const formatDate = (date: Date) =>
	date.toLocaleDateString('en', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
---

<Layout title="Blog" description="Blog posts from Skun Blog">
	<section class="page-hero" aria-labelledby="blog-title">
		<p class="eyebrow">/blog</p>
		<h1 id="blog-title">Ordered writing.</h1>
		<p class="lede">
			Posts, notes, and experiments will collect here in the order they are meant to be read.
		</p>
		<div class="actions" aria-label="Blog links">
			<a class="text-link" href="/rss.xml">RSS feed</a>
			<a class="plain-link" href="/">Home</a>
		</div>
	</section>

	<section class="section-grid" aria-labelledby="archive-title">
		<div class="section-heading">
			<p class="eyebrow">archive</p>
			<h2 id="archive-title">Posts</h2>
		</div>
		{
			posts.length > 0 ? (
				<ol class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
						</li>
					))}
				</ol>
			) : (
				<div class="empty-state">
					<p>No posts published yet.</p>
					<a class="text-link" href="/rss.xml">Subscribe for later</a>
				</div>
			)
		}
	</section>
</Layout>

<style>
	.post-list {
		display: grid;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-list li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.post-list a {
		font-weight: 620;
		text-decoration: none;
	}

	time {
		color: var(--color-subtle);
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.post-list li {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
