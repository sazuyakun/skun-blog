---
import { getCollection } from 'astro:content';
import BlogPostList from '../../components/blog/BlogPostList.astro';
import EmptyState from '../../components/EmptyState.astro';
import SectionBlock from '../../components/SectionBlock.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => a.data.order - b.data.order,
);

---

<Layout title="Blog" description="Blog posts from Skun Blog">
	<section class="page-hero" aria-labelledby="blog-title">
		<p class="eyebrow">/blog</p>
		<h1 id="blog-title">Ordered writing.</h1>
		<p class="lede">
			Posts, notes, and experiments will collect here in the order they are meant to be read.
		</p>
		<div class="actions" aria-label="Blog links">
			<a class="text-link" href="/rss.xml">RSS feed</a>
			<a class="plain-link" href="/">Home</a>
		</div>
	</section>

	<SectionBlock eyebrow="archive" title="Posts" titleId="archive-title">
		{
			posts.length > 0 ? (
				<BlogPostList posts={posts} />
			) : (
				<EmptyState message="No posts published yet." href="/rss.xml" label="Subscribe for later" />
			)
		}
	</SectionBlock>
</Layout>
