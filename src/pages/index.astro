---
import { getCollection } from 'astro:content';
import BlogPostList from '../components/blog/BlogPostList.astro';
import EmptyState from '../components/EmptyState.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestPosts = (await getCollection('blog', ({ data }) => data.draft !== true))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="home-hero" aria-labelledby="home-title">
		<div class="hero-copy signal-rail">
			<p class="eyebrow">Personal dispatch / systems and software</p>
			<h1 id="home-title">Notes from the edge of code.</h1>
			<p class="lede">
				A working log of software, systems, experiments, and the ideas that survive building
				things.
			</p>
			<div class="actions" aria-label="Primary links">
				<a class="text-link" href="/blog">Read the latest</a>
				<a class="plain-link" href="/about">Open the colophon</a>
			</div>
		</div>

		<aside class="current-trace" aria-labelledby="trace-title">
			<div class="trace-heading">
				<p class="eyebrow" id="trace-title">Current trace</p>
				<span>Live / 03</span>
			</div>
			<dl>
				<div><dt>Building</dt><dd>Small, durable systems</dd></div>
				<div><dt>Learning</dt><dd>How pieces connect</dd></div>
				<div><dt>Writing</dt><dd>Field notes from the work</dd></div>
			</dl>
		</aside>
	</section>

	<section class="transmissions" aria-labelledby="latest-title">
		<header>
			<div>
				<p class="eyebrow">01 / Latest transmissions</p>
				<h2 id="latest-title">Recent writing</h2>
			</div>
			<a class="plain-link" href="/blog">Full manifest</a>
		</header>
		{
			latestPosts.length > 0 ? (
				<BlogPostList posts={latestPosts} variant="compact" />
			) : (
				<EmptyState message="No posts published yet." href="/blog" label="Open the archive" />
			)
		}
	</section>
</Layout>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(17rem, 0.75fr);
		align-items: end;
		gap: clamp(3rem, 8vw, 7rem);
		padding-bottom: clamp(5rem, 10vw, 8rem);
	}

	.hero-copy h1 {
		max-width: 8.2ch;
	}

	.hero-copy .lede {
		max-width: 34rem;
	}

	.current-trace {
		position: relative;
		border-top: 1px solid color-mix(in srgb, var(--color-accent) 62%, var(--color-border));
		border-bottom: 1px solid var(--color-border);
		padding: 1.25rem 0;
	}

	.current-trace::after {
		position: absolute;
		top: -0.25rem;
		right: 0;
		width: 0.5rem;
		height: 0.5rem;
		border: 1px solid var(--color-accent);
		content: "";
	}

	.trace-heading {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--color-subtle);
		font-family: var(--font-atkinson);
		font-size: 0.62rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.trace-heading .eyebrow {
		margin: 0;
	}

	dl {
		margin: 1.25rem 0 0;
	}

	dl div {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: 0.75rem;
		padding: 0.7rem 0;
		border-top: 1px solid var(--color-border);
	}

	dt {
		color: var(--color-subtle);
		font-family: var(--font-atkinson);
		font-size: 0.62rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	dd {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-atkinson);
		font-size: 1rem;
		line-height: 1.3;
	}

	.transmissions {
		padding-top: clamp(2rem, 5vw, 3rem);
		border-top: 1px solid var(--color-border);
	}

	.transmissions > header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.transmissions .eyebrow {
		margin-bottom: 0.5rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 620;
		letter-spacing: -0.05em;
	}

	@media (max-width: 760px) {
		.home-hero {
			grid-template-columns: 1fr;
			gap: 4rem;
		}

		.current-trace {
			margin-left: 1.25rem;
		}
	}

	@media (max-width: 480px) {
		.transmissions > header {
			align-items: start;
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
