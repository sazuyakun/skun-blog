---
import SocialIcon from './SocialIcon.astro';
import T2 from './typography/T2.astro';
import { SOCIALS } from '../consts';

const today = new Date();
---

<footer>
	<div>
		<T2 class="end-mark">End of log</T2>
		<nav aria-label="Footer links">
			<T2 as="a" class="box-link brush-hover" href="/rss.xml">RSS</T2>
		</nav>
		<div class="footer-meta">
			<T2>&copy; {today.getFullYear()} Skun Blog</T2>
			<nav class="social-icons" aria-label="Social profiles">
				{
					SOCIALS.map((social) => (
						<a
							class="brush-hover"
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${social.name} (opens in a new tab)`}
						>
							<SocialIcon name={social.icon} />
						</a>
					))
				}
			</nav>
		</div>
	</div>
</footer>
<style>
	footer {
		border: 1px solid var(--color-border);
		color: var(--color-muted);
		font-family: var(--font-editor);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	footer > div {
		display: grid;
		grid-template-columns: auto auto 1fr;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.5rem;
	}

	.end-mark {
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		border: 1px solid var(--color-border);
		color: var(--color-accent);
		line-height: 1;
		padding: 0.65rem 0.9rem;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	a {
		text-decoration: none;
	}

	.footer-meta > span {
		display: flex;
		align-items: center;
		height: 1rem;
		line-height: 1;
	}

	.footer-meta,
	.social-icons {
		display: flex;
		align-items: center;
	}

	.footer-meta {
		justify-content: flex-end;
		gap: 0.5rem;
		min-height: 2.75rem;
		border: 1px solid var(--color-border);
		padding-left: 0.9rem;
		text-align: right;
		white-space: nowrap;
	}

	.social-icons {
		gap: 0.35rem;
	}

	.social-icons a {
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border: 1px solid var(--color-border);
		color: var(--color-muted);
		line-height: 1;
		padding: 0.6rem;
	}

	@media (max-width: 640px) {
		footer > div {
			grid-template-columns: 1fr auto;
		}

		.footer-meta {
			grid-column: 1 / -1;
			justify-content: space-between;
		}
	}
</style>
