---
import { getCollection } from 'astro:content';
import BlogPostList from '../components/blog/BlogPostList.astro';
import EmptyState from '../components/EmptyState.astro';
import H1 from '../components/typography/H1.astro';
import T1 from '../components/typography/T1.astro';
import T2 from '../components/typography/T2.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestPosts = (await getCollection('blog', ({ data }) => data.draft !== true))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="home-hero" aria-labelledby="home-title">
		<div class="hero-copy signal-rail">
			<T2 as="p" class="eyebrow">Personal dispatch / systems and software</T2>
			<H1 id="home-title">Notes from the edge of code.</H1>
			<T1 class="lede">
				A working log of software, systems, experiments, and the ideas that survive building
				things.
			</T1>
			<div class="actions" aria-label="Primary links">
				<T2 as="a" class="text-link" href="/blog">Read the latest</T2>
				<T2 as="a" class="plain-link" href="/about">About me</T2>
			</div>
		</div>
	</section>

	<section class="transmissions" aria-labelledby="latest-title">
		<header>
			<T1 as="h2" class="eyebrow" id="latest-title">Latest posts</T1>
			<T1 as="a" class="plain-link" href="/blog">Full manifest</T1>
		</header>
		{
			latestPosts.length > 0 ? (
				<BlogPostList posts={latestPosts} variant="compact" />
			) : (
				<EmptyState message="No posts published yet." href="/blog" label="Open the archive" />
			)
		}
	</section>
</Layout>

<style>
	.home-hero {
		padding-bottom: clamp(5rem, 10vw, 8rem);
	}

	.hero-copy h1 {
		max-width: 8.2ch;
	}

	.hero-copy .lede {
		max-width: 34rem;
	}

	.transmissions {
		padding-top: clamp(2rem, 5vw, 3rem);
		border-top: 1px solid var(--color-border);
	}

	.transmissions > header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.transmissions h2.eyebrow {
		margin: 0;
	}

	@media (max-width: 480px) {
		.transmissions > header {
			align-items: start;
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
