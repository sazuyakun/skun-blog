---
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero" aria-labelledby="home-title">
		<p class="eyebrow">~/skun-blog</p>
		<h1 id="home-title">Notes from the edge of code.</h1>
		<p class="lede">
			A quiet place for writing about software, systems, experiments, and the ideas that keep
			showing up while building things.
		</p>
		<div class="actions" aria-label="Primary links">
			<a class="text-link" href="/blog">Read the blog</a>
			<a class="plain-link" href="/about">About</a>
		</div>
	</section>

	<section class="latest" aria-labelledby="latest-title">
		<div class="section-heading">
			<p class="eyebrow">latest</p>
			<h2 id="latest-title">Writing</h2>
		</div>
		<div class="empty-state">
			<p>No posts published yet.</p>
			<a class="text-link" href="/blog">Open the archive</a>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding: clamp(1rem, 4vw, 2.5rem) 0 clamp(4rem, 10vw, 6rem);
	}

	.eyebrow {
		margin-bottom: 1.25rem;
		color: var(--color-accent);
		font-size: 0.9rem;
		font-weight: 620;
		letter-spacing: 0.08em;
		text-transform: lowercase;
	}

	.lede {
		max-width: 42rem;
		font-size: clamp(1.15rem, 3vw, 1.55rem);
		line-height: 1.45;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.25rem;
		margin-top: 2rem;
	}

	.plain-link {
		color: var(--color-muted);
		font-weight: 560;
		text-decoration: none;
	}

	.latest {
		display: grid;
		grid-template-columns: minmax(0, 12rem) 1fr;
		gap: 2rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border);
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		font-weight: 620;
		letter-spacing: -0.04em;
	}

	.empty-state {
		position: relative;
		padding: 1.25rem 0 1.25rem 1.25rem;
	}

	.empty-state::before {
		content: "";
		position: absolute;
		top: 0.45rem;
		bottom: 0.45rem;
		left: 0;
		width: 1px;
		background: color-mix(in srgb, var(--color-accent) 70%, var(--color-border));
	}

	.empty-state p {
		margin-bottom: 0.75rem;
	}

	@media (max-width: 640px) {
		.latest {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.empty-state {
			padding-top: 0.5rem;
		}
	}
</style>
